<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="controller.RecursoController"
      spacing="10">

    <Label text="Gestión de Recursos"/>

    <Label text="ID del recurso"/>
    <TextField fx:id="txtId"
               promptText="Ingrese el ID"/>

    <Label text="Categoría"/>
    <ComboBox fx:id="cmbCategoria"
              promptText="Seleccione una categoría"/>

    <Label text="Descripción"/>
    <TextField fx:id="txtDescripcion"
               promptText="Ingrese la descripción"/>

    <Button text="Agregar"
            onAction="#agregarRecurso"/>

    <Button text="Consultar"
            onAction="#consultarRecurso"/>

    <Button text="Modificar"
            onAction="#modificarRecurso"/>

    <Button text="Eliminar"
            onAction="#eliminarRecurso"/>

    <Button text="Limpiar"
            onAction="#limpiarCampos"/>

</VBox>